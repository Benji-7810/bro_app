# ============================================================
#  Copie ce fichier en .env et remplis ce que tu as.
#  Chaque bloc est indépendant : une source manquante ne casse
#  pas les autres, elle passe simplement en "non configurée".
#  Ne commite JAMAIS le .env.
# ============================================================

# ---- Kraken : Paramètres > API > Créer une clé -------------
# Permission à cocher : "Query Funds" UNIQUEMENT.
# Surtout pas de retrait, pas de trading.
KRAKEN_KEY=
KRAKEN_SECRET=

# ---- GoCardless Bank Account Data (ex-Nordigen) ------------
# Inscription gratuite : bankaccountdata.gocardless.com
# Couvre LCL et Fortuneo. Lecture seule.
GOCARDLESS_ID=
GOCARDLESS_KEY=

# ---- PokemonTCG.io : cartes à l'unité ----------------------
# Gratuit sans clé (20 000 appels/jour avec clé, 1 000 sans).
# dev.pokemontcg.io
POKEMONTCG_KEY=

# ---- TCG API : produits scellés (tcgapi.dev) --------------
# Gratuit : 100 requêtes/jour. Crée un compte sur tcgapi.dev,
# récupère la clé, colle-la ici. Une simple clé, pas d'OAuth.
# Prix marché TCGplayer (US), convertis en EUR.
TCGAPI_KEY=

# ---- CardTrader : prix EUROPÉENS du scellé (optionnel) ----
# Marketplace européenne. Si renseigné, le scellé prend la plus
# basse annonce EUR de CardTrader (plus proche du prix français)
# au lieu du prix US converti. Jeton gratuit :
# compte CardTrader > Settings > API Access > Create New Token.
CARDTRADER_KEY=

# ---- PriceCharting : alternative scellé (payant) -----------
# pricecharting.com/api-documentation
PRICECHARTING_TOKEN=

# ---- Cadence de collecte (minutes) -------------------------
INTERVAL_CRYPTO=5
INTERVAL_BOURSE=30
INTERVAL_CARTES=360
INTERVAL_BANQUE=720

# ---- Serveur ----------------------------------------------
HOST=127.0.0.1
PORT=8000
